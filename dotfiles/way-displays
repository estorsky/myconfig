# yaml-language-server: $schema=https://raw.githubusercontent.com/alex-courtis/way-displays/refs/heads/master/schema/cfg-2.0.0-SNAPSHOT.yaml

## way-displays configuration for ASUS laptop
## Automatic display management for Sway

## Arrange displays in a row from left to right
ARRANGE: ROW

## Align displays at the top
ALIGN: TOP

## Display order from left to right
## Displays are identified by serial numbers (independent of port names like DP-9/DP-11/etc)
ORDER:
  - 'Dangbei'       # Home: Dangbei projector
  - '3342300043348' # Home: Xiaomi Mi Monitor (DP-2 or HDMI-A-1)
  - eDP-1           # Built-in laptop display (last, fallback)
  - 'JCLMQS009609'  # Office: ASUS VS229 left monitor
  - 'KALMQS121524'  # Office: ASUS VS229 right monitor

## Enable scaling
SCALING: TRUE

## Automatic scaling by DPI (96 DPI = scale 1.0)
## Built-in high-DPI display will automatically get scale ~2.0
AUTO_SCALE: TRUE

AUTO_SCALE_MIN: 1.0
AUTO_SCALE_MAX: 2.0

## Override automatic scaling for specific displays
SCALE:
  # Home monitor Xiaomi - no scaling (was 1.125 by default)
  '3342300043348': 1.0

  # Office monitors ASUS - no scaling
  'JCLMQS009609': 1.0
  'KALMQS121524': 1.0

  'Dangbei': 2.0

## Override display modes
MODE:
  # Built-in display - maximum mode (2880x1800@120Hz)
  eDP-1:
    MAX: TRUE

  # Home monitor: Xiaomi Mi Monitor - 2560x1440@144Hz (actually 143.998Hz)
  '3342300043348':
    WIDTH: 2560
    HEIGHT: 1440
    HZ: 144

  # Office monitors: ASUS VS229 - 1920x1080@60Hz
  'JCLMQS009609':
    WIDTH: 1920
    HEIGHT: 1080
    HZ: 60

  'KALMQS121524':
    WIDTH: 1920
    HEIGHT: 1080
    HZ: 60

## VRR / adaptive sync is enabled by default
## Disable for office monitors ASUS VS229 - they don't support VRR
VRR_OFF:
  - 'ASUS VS229'
  - 'Mi Monitor'

## Notifications on display changes, then re-bind workspaces to the new layout
CALLBACK_CMD: notify-send "way-displays ${CALLBACK_LEVEL}" "${CALLBACK_MSG}"; ~/myconfig/scripts/sway_workspace_layout.sh

## Logging level
LOG_THRESHOLD: INFO

## Turn the built-in display off while docked, and while the lid is shut.
## Two entries rather than one: a list under IF is combined with AND, whereas
## entries whose key matches the same display are combined with OR. For the same
## reason the external monitors are one regex instead of three PLUGGED entries.
## The '!^eDP' entry replaces LAPTOP_DISPLAY_PREFIX, dropped in the v2 schema.
DISABLED:
  'eDP-1':
    IF:
    - PLUGGED:
      - '!(3342300043348|JCLMQS009609|KALMQS121524)'

  '!^eDP':
    IF:
    - LID: CLOSED
