# Local SOCKS5 used by myconfig outside the Cursor routing helper: proxychains
# (fallback for eopkg/pip/git/curl in scripts/solus, cursor_agent_proxy.sh),
# google-chrome-beta-proxy, Telegram download, xray-sub-install.
#   10808 - local xray from the VPN subscription (xray-sub.service, user unit)
#   12334 - Hiddify
# Apply to /usr/local/etc/proxychains.conf: ~/myconfig/scripts/solus proxy
# The host must be a numeric IPv4 address (proxychains requirement).
MYCONFIG_SOCKS_HOST=127.0.0.1
MYCONFIG_SOCKS_PORT=10808
