#!/bin/bash

set -e

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/proxy_env.sh"

proxy_server="${GOOGLE_CHROME_BETA_PROXY_SERVER:-${MYCONFIG_PROXY_SERVER:-socks5://${MYCONFIG_SOCKS_HOST}:${MYCONFIG_SOCKS_PORT}}}"
chrome_bin="${GOOGLE_CHROME_BETA_BIN:-$(command -v google-chrome-beta 2>/dev/null || true)}"

if [[ -z "$chrome_bin" ]]; then
    echo "google-chrome-beta binary was not found" >&2
    exit 1
fi

exec "$chrome_bin" --proxy-server="$proxy_server" "$@"
