#!/bin/bash

set -e

disable_quic="${CURSOR_DISABLE_QUIC:-1}"

has_flag() {
    local wanted="$1"
    shift
    local arg

    for arg in "$@"; do
        [[ "$arg" == "$wanted" ]] && return 0
    done

    return 1
}

find_cursor_bin() {
    local candidate

    for candidate in \
        "${CURSOR_BIN:-}" \
        "$HOME/Dropbox/bin/cursor" \
        "$HOME/.local/bin/cursor" \
        "/usr/local/bin/cursor" \
        "/usr/bin/cursor"
    do
        if [[ -n "$candidate" && -x "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    command -v cursor 2>/dev/null || true
}

script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
routing_env_file="${CURSOR_SELECTIVE_ROUTING_ENV_FILE:-${script_dir}/../dotfiles/cursor-routing.env}"
if [[ -z "${CURSOR_SELECTIVE_ROUTING_SOCKS_PORT:-}" && -f "$routing_env_file" ]]; then
    # shellcheck disable=SC1090
    . "$routing_env_file"
fi
source "${script_dir}/proxy_env.sh"

proxy_server="${CURSOR_PROXY_SERVER:-${MYCONFIG_PROXY_SERVER:-socks5://${MYCONFIG_SOCKS_HOST}:${CURSOR_SELECTIVE_ROUTING_SOCKS_PORT:-${MYCONFIG_SOCKS_PORT}}}}"
cursor_bin="$(find_cursor_bin)"

if [[ -z "$cursor_bin" ]]; then
    echo "cursor binary was not found" >&2
    exit 1
fi

if [[ "$disable_quic" == "1" ]] && ! has_flag "--disable-quic" "$@"; then
    set -- --disable-quic "$@"
fi

exec "$cursor_bin" --proxy-server="$proxy_server" "$@"
